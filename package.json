  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed:venues": "ts-node --transpile-only src/seed-venues.ts",
    "seed:data": "ts-node --transpile-only src/seed-data.ts",
    "seed:bookings": "ts-node --transpile-only src/scripts/seed-bookings.ts",
    "seed:full": "ts-node --transpile-only src/scripts/seed-full-bookings.ts",
    "revenue:summary": "ts-node --transpile-only src/scripts/populate-revenue-summary.ts",
    "remove:momo": "ts-node --transpile-only src/scripts/remove-momo.ts"
  },
  "dependencies": {
