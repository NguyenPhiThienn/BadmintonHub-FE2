    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.0.0",
    "@types/multer": "^1.4.13",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.6.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-basic-auth": "^1.2.0",
    "groq-sdk": "^1.1.2",
    "mongoose": "^8.14.1",
    "multer": "^2.0.1",
